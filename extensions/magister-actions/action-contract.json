    {
      "action": "create_social_draft",
      "approval_policy": "none",
      "async_status_adapter": "synchronous",
      "description": "Create an unpublished social draft from the exact supplied media. media_urls accepts saved generated image/video paths or stable public assets; never substitute or regenerate media. Scheduling and publishing are separate approvals.",
      "idempotency_enforcement": "registry",
      "idempotency_policy": "idempotency_key",
      "input_schema": {
        "$defs": {
          "SocialTarget": {
            "additionalProperties": false,
            "properties": {
              "account_id": {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              "platform": {
                "maxLength": 50,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["platform", "account_id"],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "media_urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
