{
  "id": "magister-actions",
  "name": "Magister Actions",
  "description": "Typed, project-scoped marketing actions executed through the Magister gateway.",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "magister_get_brand",
      "magister_list_integrations",
      "magister_get_marketing_plan",
      "magister_list_workflow_status",
      "magister_list_firehose_matches",
      "magister_record_heartbeat_escalation",
      "magister_recompile_marketing_plan",
      "magister_get_compile_run",
      "magister_get_audit_health",
      "magister_list_skills",
      "magister_get_skill",
      "magister_list_aeo_audits",
      "magister_run_aeo_audit",
      "magister_get_aeo_audit",
      "magister_list_ai_visibility_sets",
      "magister_get_ai_visibility_set",
      "magister_run_ai_visibility_set",
      "magister_keyword_research",
      "magister_discover_influencers",
      "magister_get_influencer_discovery",
      "magister_list_social_accounts",
      "magister_list_social_posts",
      "magister_get_social_analytics",
      "magister_list_ad_campaigns",
      "magister_get_ad_analytics",
      "magister_get_action_approval",
      "magister_send_email",
      "magister_create_social_draft",
      "magister_schedule_social_post",
      "magister_publish_social_post",
      "magister_create_ad_campaign",
      "magister_activate_ad_campaign",
      "magister_pause_ad_campaign",
      "magister_create_blog_post",
      "magister_update_blog_post",
      "magister_open_pull_request",
      "magister_create_product",
      "magister_publish_content",
      "magister_merge_pull_request",
      "magister_submit_workflow_completion",
      "magister_promote_artifact"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000
      },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 2097152
      }
    }
  }
}
